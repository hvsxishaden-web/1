rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stats collection (used for visitor counter)
    match /stats/{statId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    // Default deny for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
